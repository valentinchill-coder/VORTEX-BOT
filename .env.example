BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE
# Optional: comma-separated Telegram user IDs who can use bot admin commands
OWNER_IDS=
# Optional one-time readiness notice to OWNER_IDS on startup (disable after delivery)
# AUDIT_READY_NOTIFY=1
DATABASE_PATH=vortex.db

# Local development uses polling by default.
# Render automatically switches to webhook when RENDER_EXTERNAL_HOSTNAME is present.
# Optional overrides:
# BOT_MODE=polling
# PUBLIC_URL=https://your-service.onrender.com
# WEBHOOK_SECRET=generate-a-long-random-secret
